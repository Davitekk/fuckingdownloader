# Copy to .env and change these.

# Password for the admin/settings panel. REQUIRED, otherwise the panel is disabled.
ADMIN_PASSWORD=change-me-to-something-long

# Where the admin panel lives. Pick something non-obvious, e.g. "boss-zone-83jd".
ADMIN_PATH=admin

# Signs the admin session cookie. Leave empty to auto-generate (stored in /data/.secret_key).
SECRET_KEY=

# Set to true when running behind a reverse proxy (Caddy, nginx, Traefik, Cloudflare Tunnel)
# so per-IP limits see the real visitor IP instead of the proxy's.
TRUST_PROXY=false

# Set to true when served over HTTPS so the admin cookie is marked Secure.
COOKIE_SECURE=false

# Update yt-dlp / gallery-dl / spotdl every time the container starts (recommended, sites break often).
AUTO_UPDATE=true
